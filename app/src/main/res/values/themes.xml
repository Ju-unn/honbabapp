<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Honbabapp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary_100</item>
        <item name="colorPrimaryVariant">@color/primary_200</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/accent_100</item>
        <item name="colorSecondaryVariant">@color/accent_200</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@color/bg_100</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_100</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        
    </style>

    <style name="Theme.Honbabapp" parent="Base.Theme.Honbabapp" >
        <item name="android:windowIsTranslucent">true</item>
    </style>

</resources>