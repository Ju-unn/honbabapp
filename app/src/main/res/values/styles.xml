<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         U0 디자인시스템 통일 · 공통 위젯 스타일
         주의: Material3 테마가 <Button>을 MaterialButton으로 morph하여
         android:background drawable을 무시함 → 버튼은 backgroundTint +
         cornerRadius(Material 속성)로 제어한다.
         버튼: 높이 50dp / cornerRadius 12dp / 16sp Bold / inset 0
         입력: EditText는 morph 안 됨 → 기존 drawable(edittext_background) 사용
         각 화면은 style="@style/Widget.Honbab.Button.*" 로 적용한다.
         ============================================================ -->

    <!-- 버튼 공통 베이스 (MaterialButton) -->
    <style name="Widget.Honbab.Button" parent="Widget.Material3.Button">
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Primary CTA -->
    <style name="Widget.Honbab.Button.Primary" parent="Widget.Honbab.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/primary_button_bg</item>
    </style>

    <!-- Danger (위험/삭제) -->
    <style name="Widget.Honbab.Button.Danger" parent="Widget.Honbab.Button">
        <item name="android:textColor">@color/danger_button_text</item>
        <item name="backgroundTint">@color/danger_button_bg</item>
    </style>

    <!-- Disabled (기본 회색; 상태 무관하게 비활성 표현이 필요할 때) -->
    <style name="Widget.Honbab.Button.Disabled" parent="Widget.Honbab.Button">
        <item name="android:textColor">@color/text_200</item>
        <item name="backgroundTint">@color/bg_300</item>
    </style>

    <!-- Outline (보조) : OutlinedButton 기반 = 투명 배경 + 테두리 -->
    <style name="Widget.Honbab.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">50dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/text_100</item>
        <item name="strokeColor">@color/border_100</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- 입력 필드 (EditText — morph 안 됨, drawable 사용) -->
    <style name="Widget.Honbab.Input" parent="">
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/edittext_background</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_100</item>
        <item name="android:textColorHint">@color/text_200</item>
    </style>

</resources>
