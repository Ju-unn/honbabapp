<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 눌려진 상태 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_200" />
            <stroke
                android:width="1dp"
                android:color="@color/border_100" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- 일반 상태 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_100" />
            <stroke
                android:width="1dp"
                android:color="@color/border_100" />
            <corners android:radius="20dp" />
        </shape>
    </item>

</selector>