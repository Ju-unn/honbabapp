<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- 프로필 이미지 (원형) -->
    <FrameLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp">

        <!-- ShapeableImageView로 교체: 원형 처리를 background 없이 직접 처리 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRoomProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Honbab.Profile.Circle" />

        <!-- 모임 채팅 배지 (meeting_id != null 일 때만 표시). 우하단. -->
        <ImageView
            android:id="@+id/imgMeetingBadge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="bottom|end"
            android:src="@drawable/meeting_badge"
            android:contentDescription="모임 채팅"
            android:visibility="gone" />

    </FrameLayout>

    <!-- 채팅 정보 (제목 + 마지막 메시지) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 채팅방 제목 -->
        <TextView
            android:id="@+id/textRoomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="채팅방 이름"
            android:textColor="@color/text_100"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 마지막 메시지 미리보기 -->
        <TextView
            android:id="@+id/textLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/text_200"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- 시간 + 읽지 않은 수 (오른쪽) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- 시간 텍스트: id 추가 (Java에서 last_msg_time 바인딩 필요) -->
        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text=""
            android:textColor="@color/text_200"
            android:textSize="11sp" />

        <!-- 읽지 않은 메시지 뱃지: 기본값 gone으로 변경 (Java에서 조건부 표시) -->
        <!-- 기존 visibility="visible" → gone: count가 0일 때도 보이는 버그 수정 -->
        <TextView
            android:id="@+id/badgeUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/unread_badge_background"
            android:gravity="center"
            android:minHeight="20dp"
            android:minWidth="20dp"
            android:paddingHorizontal="6dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>