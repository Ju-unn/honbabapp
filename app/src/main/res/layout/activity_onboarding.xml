<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 타이틀 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="추가 정보를 입력해주세요"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_100"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- ===================== 닉네임 (조건부 표시) ===================== -->
        <LinearLayout
            android:id="@+id/layout_nickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="닉네임"
                android:textSize="14sp"
                android:textColor="@color/text_200"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_nickname"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="닉네임 입력 (2-10자)"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_check_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="중복확인"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_nickname_check_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ===================== 전화번호 (조건부 표시) ===================== -->
        <LinearLayout
            android:id="@+id/layout_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전화번호"
                android:textSize="14sp"
                android:textColor="@color/text_200"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_phone_number"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:hint="010-0000-0000"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:inputType="phone"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_check_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:text="중복확인"
                    android:textSize="13sp"
                    android:paddingHorizontal="12dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_phone_check_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ===================== 위치 선택 (비어있을 때만 표시) ===================== -->
        <LinearLayout
            android:id="@+id/layout_location_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="활동 지역"
                android:textSize="14sp"
                android:textColor="@color/text_200"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/layout_location_select"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_selected_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="위치를 선택해주세요"
                    android:textColor="@color/text_200"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ===================== 성별 (비어있을 때만 표시) ===================== -->
        <LinearLayout
            android:id="@+id/layout_gender_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="성별"
                android:textSize="14sp"
                android:textColor="@color/text_200"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gender_male"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="남성"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/gender_button_background_tint"
                    app:strokeColor="@color/gender_button_stroke_color"
                    app:strokeWidth="1dp"
                    android:textColor="@color/gender_button_text_color"
                    app:cornerRadius="8dp"
                    android:layout_marginEnd="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_gender_female"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="여성"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/gender_button_background_tint"
                    app:strokeColor="@color/gender_button_stroke_color"
                    app:strokeWidth="1dp"
                    android:textColor="@color/gender_button_text_color"
                    app:cornerRadius="8dp"
                    android:layout_marginStart="5dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===================== 생일 (비어있을 때만 표시) ===================== -->
        <LinearLayout
            android:id="@+id/layout_birthday_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="생년월일"
                android:textSize="14sp"
                android:textColor="@color/text_200"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/layout_birthday_select"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_selected_birthday"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="생년월일을 선택해주세요"
                    android:textColor="@color/text_200"
                    android:textSize="14sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ===================== 완료 버튼 ===================== -->
        <Button
            android:id="@+id/btn_complete_onboarding"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="완료"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_background"
            android:elevation="2dp"/>

    </LinearLayout>

</ScrollView>