<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/register"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <!-- 제목 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="회원가입"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="42dp"/>

    </LinearLayout>

    <!-- 진행바 (스텝 라벨 + N/5 + 둥근 진행바) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_100"
        android:paddingHorizontal="22dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_step_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1단계 · 이메일 인증"
                android:textColor="@color/text_100"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_step_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1/5"
                android:textColor="@color/primary_200"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_step"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="5"
            android:progress="1"
            android:progressDrawable="@drawable/progress_step_bar"/>

    </LinearLayout>

    <!-- 스텝 전환 컨테이너 -->
    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= STEP 1 · 이메일 + 인증 ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이메일로 시작하기"
                    android:textColor="@color/primary_200"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="본인 확인을 위해 이메일 인증을 진행해 주세요."
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp"/>

                <!-- 이메일 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이메일"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <EditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="이메일을 입력해 주세요"
                            android:textColorHint="@color/text_200"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:inputType="textEmailAddress"
                            android:background="@drawable/edittext_background"
                            android:paddingHorizontal="14dp" />

                        <TextView
                            android:id="@+id/tv_email_check_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_send_verification"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="중복확인"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_primary_background"
                        android:minWidth="80dp" />

                </LinearLayout>

                <!-- 인증번호 입력 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="인증번호"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <EditText
                            android:id="@+id/et_verification_code"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="인증번호를 입력해 주세요"
                            android:textColorHint="@color/text_200"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:inputType="number"
                            android:background="@drawable/edittext_background"
                            android:paddingHorizontal="14dp"
                            android:maxLength="6"
                            android:enabled="false"/>

                        <TextView
                            android:id="@+id/tv_verify_code_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/tv_verification_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_verify_code"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:text="확인"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_primary_background"
                        android:minWidth="80dp"
                        android:enabled="false"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ================= STEP 2 · 비밀번호 ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 설정"
                    android:textColor="@color/primary_200"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8자 이상, 영문/숫자/특수문자를 사용할 수 있어요."
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp"/>

                <!-- 비밀번호 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="비밀번호를 입력해 주세요"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:inputType="textPassword"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="14dp"
                    android:layout_marginBottom="18dp"
                    android:maxLength="14"/>

                <!-- 비밀번호 확인 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비밀번호 확인"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <EditText
                    android:id="@+id/et_password_confirm"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="비밀번호를 다시 입력해 주세요"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:inputType="textPassword"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="14dp"
                    android:layout_marginBottom="18dp"
                    android:maxLength="14"/>

                <TextView
                    android:id="@+id/tv_password_match"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </ScrollView>

        <!-- ================= STEP 3 · 닉네임 ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="닉네임 정하기"
                    android:textColor="@color/primary_200"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다른 사용자에게 보여질 이름이에요. (2~10자)"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp"/>

                <!-- 닉네임 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="닉네임"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/et_nickname"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="사용할 닉네임을 입력해 주세요"
                            android:textColorHint="@color/text_200"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:inputType="text"
                            android:background="@drawable/edittext_background"
                            android:paddingHorizontal="14dp"
                            android:maxLength="10"/>

                        <TextView
                            android:id="@+id/tv_nickname_check_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ================= STEP 4 · 전화번호 ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전화번호 확인"
                    android:textColor="@color/primary_200"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="안전한 모임을 위해 전화번호를 확인해 주세요."
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp"/>

                <!-- 전화번호 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="전화번호"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="2"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="10dp">

                        <EditText
                            android:id="@+id/et_phone_number"
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:hint="010-1234-5678"
                            android:textColorHint="@color/text_200"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:inputType="phone"
                            android:background="@drawable/edittext_background"
                            android:paddingHorizontal="14dp"
                            android:maxLength="13"/>

                        <TextView
                            android:id="@+id/tv_phone_check_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- ================= STEP 5 · 프로필/생년월일/성별/동네 ================= -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="프로필 완성"
                    android:textColor="@color/primary_200"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="마지막이에요! 기본 정보를 입력해 주세요."
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp"/>

                <!-- 프로필 이미지 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="프로필 이미지"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginBottom="18dp">

                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/iv_profile_preview"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/ic_person"
                            android:background="@drawable/profile_avatar_background"
                            android:scaleType="centerCrop"
                            android:clipToOutline="true"/>

                        <ImageButton
                            android:id="@+id/btn_select_profile_image"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_camera"
                            android:background="@drawable/camera_button_background"
                            android:layout_gravity="bottom|end"
                            android:elevation="4dp" />

                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이미지를 선택해 주세요 (선택사항)"
                        android:textColor="@color/text_200"
                        android:textSize="11sp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_birthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_label_birthday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="생년월일"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="7dp" />

                    <EditText
                        android:id="@+id/et_birthdate"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:hint="생년월일을 선택해 주세요"
                        android:textColorHint="@color/text_200"
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:inputType="date"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="18dp"
                        android:focusable="false"
                        android:clickable="true" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="성별"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="7dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="18dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_gender_male"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="남성"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/gender_button_background_tint"
                            app:strokeColor="@color/gender_button_stroke_color"
                            app:strokeWidth="1dp"
                            android:textColor="@color/gender_button_text_color"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="5dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_gender_female"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="여성"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:backgroundTint="@color/gender_button_background_tint"
                            app:strokeColor="@color/gender_button_stroke_color"
                            app:strokeWidth="1dp"
                            android:textColor="@color/gender_button_text_color"
                            app:cornerRadius="8dp"
                            android:layout_marginStart="5dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 내 동네 설정 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 동네 설정"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <LinearLayout
                    android:id="@+id/layout_location_select"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="14dp"
                    android:layout_marginBottom="28dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tv_selected_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="동네를 선택해 주세요"
                        android:textColor="@color/text_200"
                        android:textSize="14sp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </ViewFlipper>

    <!-- 하단 고정 네비게이션 (이전 / 다음) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <!-- 이전 버튼 (스텝1에서는 숨김) -->
            <Button
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="이전"
                android:textColor="@color/text_100"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/edittext_background"
                android:layout_marginEnd="10dp"
                android:visibility="gone"/>

            <!-- 다음 / 회원가입 완료 버튼 -->
            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:text="다음"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_primary_background"
                android:elevation="2dp" />

        </LinearLayout>

        <!-- 약관 동의 텍스트 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="회원가입 시 이용약관 및 개인정보처리방침에 동의하게 됩니다."
            android:textColor="@color/text_200"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</LinearLayout>
