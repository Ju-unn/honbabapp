<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!--    상단 헤더-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <!--        제목-->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="프로필 수정"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="56dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!--            프로필 이미지 섹션-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <!--                프로필 이미지-->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:id="@+id/iv_profile_avatar"
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:padding="3dp"
                        android:background="@drawable/profile_avatar_background" />

                    <!-- 카메라 아이콘 -->
                    <ImageButton
                        android:id="@+id/btn_change_avatar"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_camera"
                        android:background="@drawable/camera_button_background"
                        android:layout_gravity="bottom|end"
                        android:elevation="4dp" />

                </FrameLayout>

                <!--                현재 닉네임-->
                <TextView
                    android:id="@+id/tv_current_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="고기 아저씨"
                    android:textColor="@color/text_100"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"
                    android:letterSpacing="-0.02" />

            </LinearLayout>

            <!--            닉네임-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="닉네임"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- EditText + 중복확인 버튼을 가로로 배치 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_nickname"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_weight="1"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="16dp"
                        android:maxLength="10"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btn_check_nickname"
                        android:layout_width="wrap_content"
                        android:layout_height="45dp"
                        android:text="중복확인"
                        android:textSize="13sp"
                        android:textColor="@color/white"
                        android:background="@drawable/button_primary_background"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="12dp"
                        app:backgroundTint="@null" />

                </LinearLayout>

                <!-- 중복확인 결과 메시지 -->
                <TextView
                    android:id="@+id/tv_nickname_check_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2-10자 사이로 입력하세요 (한글, 영문, 숫자만 가능)"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!--            상태 메세지-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상태 메세지"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_status_message"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:gravity="top"
                    android:maxLength="50"
                    android:inputType="textMultiLine" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="최대 50자까지 입력 가능합니다"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- ========== SNS 계정 섹션 (체험단 신청용) ========== -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginBottom="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SNS 계정"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="체험단 신청 시 사용"
                    android:textColor="@color/primary_100"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="체험단 신청 시 호스트에게 공개됩니다. 입력하지 않으면 체험단 신청이 불가합니다."
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="16dp" />

            <!-- 인스타그램 ID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="인스타그램 ID"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_instagram_visit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="이동하기 &gt;"
                        android:textColor="@color/primary_200"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@"
                        android:textColor="@color/text_200"
                        android:textSize="15sp"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/et_instagram_id"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="인스타그램 아이디"
                        android:textColorHint="@color/text_200"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:background="@null"
                        android:maxLength="50"
                        android:inputType="text"
                        android:imeOptions="actionNext" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" '@' 없이 아이디만 입력하세요"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 블로그 ID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="블로그 ID"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_blog_visit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="이동하기 &gt;"
                        android:textColor="@color/primary_200"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground" />

                </LinearLayout>

                <EditText
                    android:id="@+id/et_blog_id"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="네이버 블로그 ID"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:maxLength="50"
                    android:inputType="text"
                    android:imeOptions="actionNext" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="네이버 블로그 URL에서 아이디 부분만 입력하세요"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 유튜브 ID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="유튜브 ID"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_youtube_visit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="이동하기 &gt;"
                        android:textColor="@color/primary_200"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackground" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@"
                        android:textColor="@color/text_200"
                        android:textSize="15sp"
                        android:layout_marginEnd="4dp" />

                    <EditText
                        android:id="@+id/et_youtube_id"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="유튜브 채널 아이디"
                        android:textColorHint="@color/text_200"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:background="@null"
                        android:maxLength="50"
                        android:inputType="text"
                        android:imeOptions="actionDone" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" '@' 없이 채널 아이디만 입력하세요 (선택 사항, 체험단 신청 필수 아님)"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
            <!-- ========== SNS 계정 섹션 끝 ========== -->

        </LinearLayout>

    </ScrollView>

    <!-- 하단 고정 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="프로필 수정"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_background"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>