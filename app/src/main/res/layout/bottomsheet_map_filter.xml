<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 📌 상단 핸들 -->
    <View
        android:id="@+id/view_handle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 📌 제목 -->
    <TextView
        android:id="@+id/tv_filter_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="필터"
        android:textColor="@color/text_100"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/view_handle" />

    <!-- 📌 닫기 버튼 -->
    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        android:contentDescription="닫기"
        app:layout_constraintBottom_toBottomOf="@id/tv_filter_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_filter_title" />

    <!-- 📌 구분선 -->
    <View
        android:id="@+id/view_divider_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/bg_200"
        app:layout_constraintTop_toBottomOf="@id/tv_filter_title" />

    <!-- 📌 Horizontal RecyclerView (탭) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_filter_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/view_divider_top" />

    <!-- 📌 구분선 -->
    <View
        android:id="@+id/view_divider_middle"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_200"
        app:layout_constraintTop_toBottomOf="@id/rv_filter_tabs" />

    <!-- 📌 ScrollView (필터 내용) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_filter_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btn_apply_filter"
        app:layout_constraintTop_toBottomOf="@id/view_divider_middle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========== 음식 종류 섹션 ========== -->
            <LinearLayout
                android:id="@+id/section_food"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="음식 종류"
                    android:textColor="@color/text_100"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_korean"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="한식"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_chinese"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="중식"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_japanese"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="일식"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <Button
                        android:id="@+id/btn_omakase"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="오마카세"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_western"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="양식"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_bar"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="술집"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                    <Button
                        android:id="@+id/btn_cafe"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="카페"
                        android:textSize="14sp"
                        android:textColor="@drawable/chip_button_text_color"
                        android:background="@drawable/chip_button_background"
                        app:backgroundTint="@null"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:stateListAnimator="@null" />

                </LinearLayout>

            </LinearLayout>

            <!-- ========== 가격대 섹션 ========== -->
            <LinearLayout
                android:id="@+id/section_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가격대"
                    android:textColor="@color/text_100"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/price_range_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="50000.0"
                    android:stepSize="1000.0"
                    app:values="@array/initial_price_range"
                    app:trackColorActive="@color/primary_100"
                    app:trackColorInactive="@color/bg_200"
                    app:thumbColor="@color/primary_100"
                    app:thumbRadius="12dp"
                    app:trackHeight="4dp"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_min_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0원"
                        android:textColor="@color/text_100"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ~ "
                        android:textColor="@color/text_200"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tv_max_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50,000원"
                        android:textColor="@color/text_100"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="빠른 선택"
                    android:textColor="@color/text_200"
                    android:textSize="14sp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_price_10k_20k"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="1만~2만원"
                        android:textSize="12sp"
                        android:textColor="@color/text_100"
                        android:background="@drawable/button_secondary_background"
                        android:backgroundTint="@null"
                        android:layout_marginEnd="8dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false" />

                    <Button
                        android:id="@+id/btn_price_20k_30k"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="2만~3만원"
                        android:textSize="12sp"
                        android:textColor="@color/text_100"
                        android:background="@drawable/button_secondary_background"
                        android:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btn_price_upper_50k"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="5만원 이상"
                        android:textSize="12sp"
                        android:textColor="@color/text_100"
                        android:background="@drawable/button_secondary_background"
                        android:backgroundTint="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:textAllCaps="false" />


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 📌 적용하기 버튼 -->
    <Button
        android:id="@+id/btn_apply_filter"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="적용하기"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/primary_100"
        android:textColor="@android:color/white"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>