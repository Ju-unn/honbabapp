<?xml version="1.0" encoding="utf-8"?>
<!--
    상대방이 보낸 메시지 (received)

    구조:
      [프로필] [닉네임]
              [말풍선 컨테이너][시간/안읽음]
                  ├─ textContent  (텍스트 메시지일 때만 visible)
                  └─ imageContent (이미지 메시지일 때만 visible)

    어댑터에서 msg.isImage() 분기로 visibility 토글.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- 프로필 이미지 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Honbab.Profile.Circle" />

    <!-- 이름 + 말풍선 세로 배치 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 발신자 이름 -->
        <TextView
            android:id="@+id/textSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text=""
            android:textColor="@color/text_200"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 말풍선 + 시간 가로 배치 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <!-- 말풍선 컨테이너: 텍스트 또는 이미지 한 가지만 보임 -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- 텍스트 메시지 말풍선 -->
                <TextView
                    android:id="@+id/textContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/message_bubble_received"
                    android:maxWidth="220dp"
                    android:padding="12dp"
                    android:text=""
                    android:textColor="@color/text_100"
                    android:textSize="15sp" />

                <!-- 이미지 메시지 (둥근 모서리) -->
                <ImageView
                    android:id="@+id/imageContent"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="@drawable/message_image_background"
                    android:clipToOutline="true"
                    android:contentDescription="채팅 이미지"
                    android:maxHeight="280dp"
                    android:minHeight="120dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

            </FrameLayout>

            <!-- 시간 + 읽지 않은 수: 말풍선 오른쪽, 하단 정렬 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="bottom"
                android:layout_gravity="bottom"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp">

                <!-- 읽지 않은 인원 수 -->
                <TextView
                    android:id="@+id/textUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/primary_100"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 수신 시간 -->
                <TextView
                    android:id="@+id/textTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_200"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>