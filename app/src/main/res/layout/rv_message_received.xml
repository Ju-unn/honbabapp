<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- 프로필 이미지 (그룹 채팅에서 발신자 식별) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgProfile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Honbab.Profile.Circle"
        xmlns:app="http://schemas.android.com/apk/res-auto"/>

    <!-- 이름 + 말풍선 + 시간 세로 배치 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="80dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 발신자 이름 (그룹 채팅일 때만 visible, 1:1이면 gone) -->
        <TextView
            android:id="@+id/textSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text=""
            android:textColor="@color/text_200"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 받은 메시지 말풍선 -->
        <TextView
            android:id="@+id/textContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/message_bubble_received"
            android:maxWidth="250dp"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/text_100"
            android:textSize="15sp" />

        <!-- 수신 시간 + 읽지 않은 수 가로 배치 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 읽지 않은 인원 수 (0이면 gone) -->
            <TextView
                android:id="@+id/textUnread"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:text=""
                android:textColor="@color/primary_100"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- 수신 시간 -->
            <TextView
                android:id="@+id/textTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/text_200"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>