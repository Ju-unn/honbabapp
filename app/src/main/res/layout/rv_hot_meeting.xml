<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp"
    android:layout_height="120dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_meeting_image"
            android:layout_width="100dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:background="#FFE4B5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 모임 제목 -->
        <TextView
            android:id="@+id/tv_meeting_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:text="강남 미슐랭 스시 오마카세"
            android:textColor="@color/text_100"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/iv_meeting_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 위치 (첫 번째 줄) -->
        <LinearLayout
            android:id="@+id/layout_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            app:layout_constraintStart_toStartOf="@id/tv_meeting_title"
            app:layout_constraintTop_toBottomOf="@id/tv_meeting_title"
            app:layout_constraintEnd_toEndOf="@id/tv_meeting_title">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_meeting_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="강남역 맛집 골목"
                android:textColor="@color/text_200"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 시간 (두 번째 줄) -->
        <LinearLayout
            android:id="@+id/layout_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="start|center_vertical"
            app:layout_constraintStart_toStartOf="@id/tv_meeting_title"
            app:layout_constraintTop_toBottomOf="@id/layout_location"
            app:layout_constraintEnd_toEndOf="@id/tv_meeting_title">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_clock"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_meeting_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오후 7:00"
                android:textColor="@color/text_200"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- 하단 정보 (참여자 수와 뱃지) - 카드 하단 고정 -->
        <TextView
            android:id="@+id/tv_participants"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="3/4명 참여"
            android:textColor="@color/primary_200"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/tv_meeting_title"
            app:layout_constraintEnd_toStartOf="@id/tv_badge"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOT"
            android:textSize="9sp"
            android:textColor="@color/white"
            android:background="@drawable/hot_badge_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            app:layout_constraintEnd_toEndOf="@id/tv_meeting_title"
            app:layout_constraintTop_toTopOf="@id/tv_participants"
            app:layout_constraintBottom_toBottomOf="@id/tv_participants" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
