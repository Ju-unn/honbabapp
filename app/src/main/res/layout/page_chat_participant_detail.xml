<?xml version="1.0" encoding="utf-8"?>
<!--
    참가자 프로필 상세 (view-only)

    [변경 사항 — 2026-06-24]
    매너점수/참여횟수 박스 아래에 "받은 리뷰" 섹션 추가:
      - 섹션 제목 TextView
      - RecyclerView (rv_received_reviews, nestedScrollingEnabled=false)
      - 빈 상태 안내 TextView (tv_no_reviews)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- ──── 상단 헤더 바 ──── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="프로필"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="56dp" />

    </LinearLayout>

    <!-- ──── 본문 ScrollView ──── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ──── 그라데이션 헤더 (아바타 + 닉네임 + 상태 + 매너/참여) ──── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="32dp"
                android:paddingBottom="28dp"
                android:background="@drawable/profile_header_background">

                <!-- 프로필 아바타 -->
                <ImageView
                    android:id="@+id/iv_profile_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/profile_avatar_background"
                    android:elevation="4dp"
                    android:padding="3dp"/>

                <!-- 닉네임 -->
                <TextView
                    android:id="@+id/tv_profile_nickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="닉네임"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- 상태 메시지 -->
                <TextView
                    android:id="@+id/tv_profile_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상태 메시지"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp"
                    android:alpha="0.9"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- 매너점수 + 참여횟수 (가로) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- 매너점수 -->
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/profile_stat_background"
                        android:padding="12dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="매너점수"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:alpha="0.8" />

                        <TextView
                            android:id="@+id/tv_manner_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- 참여횟수 -->
                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/profile_stat_background"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="참여횟수"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:alpha="0.8" />

                        <TextView
                            android:id="@+id/tv_participation_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0회"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ──────────────────────────────────── -->
            <!-- 받은 리뷰 섹션                         -->
            <!-- ──────────────────────────────────── -->

            <!-- 섹션 제목 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="받은 리뷰"
                android:textColor="@color/text_100"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="10dp" />

            <!-- 리뷰 목록 RecyclerView -->
            <!-- nestedScrollingEnabled=false: 부모 ScrollView 가 스크롤 처리하도록 함 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_received_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- 빈 상태 안내 (리뷰가 없을 때만 표시) -->
            <TextView
                android:id="@+id/tv_no_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="아직 받은 리뷰가 없습니다"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:visibility="gone" />

            <!-- 하단 여백 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>