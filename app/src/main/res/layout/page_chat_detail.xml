<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_200"
    android:orientation="vertical">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- 뒤로가기 버튼 -->
        <!-- scaleType centerCrop → centerInside 로 수정: 아이콘이 잘리지 않도록 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_arrow_back" />

        <!-- 채팅방 정보 (프로필 + 제목/부제목) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 프로필 이미지 (원형) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/im_chat_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Honbab.Profile.Circle" />

            <!-- 채팅방 제목 및 부제목 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 방 이름 (Java에서 room_name 세팅) -->
                <TextView
                    android:id="@+id/tv_chat_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="채팅방 이름"
                    android:textColor="@color/text_100"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- 그룹: 참여자 수 / 1:1: 매너온도 등 부가 정보 -->
                <!-- tv_chat_status: 그룹이면 "참여자 N명", 1:1이면 숨기거나 매너온도 -->
                <TextView
                    android:id="@+id/tv_chat_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/text_200"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- 메뉴 버튼 (나가기, 초대 등 팝업) -->
        <!-- btn_call 삭제: 앱 내 전화 기능 미구현, UX 혼란 유발 -->
        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bar3_vertical" />

    </LinearLayout>

    <!-- 메시지 목록 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_200"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:scrollbars="none" />

    <!-- 하단 입력 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- 상단 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bg_300" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:paddingEnd="8dp"
            android:paddingStart="8dp"
            android:paddingTop="8dp">

            <!-- 첨부 버튼 (이미지 전송용) -->
            <ImageButton
                android:id="@+id/btn_attach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_circle_add" />

            <!-- 메시지 입력창 -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/message_input_background"
                android:hint="메시지를 입력하세요"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/text_100"
                android:textColorHint="@color/text_200"
                android:textSize="15sp" />

            <!-- 전송 버튼 -->
            <!-- layout_height 55dp → 44dp 수정: 입력창과 높이 맞춤 -->
            <ImageButton
                android:id="@+id/btn_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_send" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>