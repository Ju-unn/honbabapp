<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_100"
    android:padding="16dp">

    <!-- 프로필 아바타 -->
    <ImageView
        android:id="@+id/iv_applicant_avatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_kakao"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- 지원자 정보 -->
    <LinearLayout
        android:id="@+id/layout_applicant_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toTopOf="@id/iv_applicant_avatar"
        app:layout_constraintBottom_toBottomOf="@id/iv_applicant_avatar"
        app:layout_constraintStart_toEndOf="@id/iv_applicant_avatar"
        app:layout_constraintEnd_toStartOf="@id/btn_accept">

        <!-- 이름 -->
        <TextView
            android:id="@+id/tv_applicant_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="카드가든"
            android:textColor="@color/text_100"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- 한 줄 소개 -->
        <TextView
            android:id="@+id/tv_applicant_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="맛집 탐방 좋아해요 🍴"
            android:textColor="@color/text_200"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="2dp" />

        <!-- 신청 시간 -->
        <TextView
            android:id="@+id/tv_apply_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10분 전"
            android:textColor="@color/text_200"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- 수락 버튼 -->
    <Button
        android:id="@+id/btn_accept"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="수락"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/button_primary_background_green"
        android:paddingHorizontal="16dp"
        android:minWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 거절 버튼 -->
    <Button
        android:id="@+id/btn_reject"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="거절"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/button_primary_background"
        android:paddingHorizontal="16dp"
        android:minWidth="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/btn_accept"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 구분선 -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/border_100"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_reject"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>