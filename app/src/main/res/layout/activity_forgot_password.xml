<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 (page_register.xml과 동일 패턴) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="비밀번호 찾기"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="42dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- 안내 문구 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="가입한 이메일로 인증코드를 보내드려요.\n인증이 완료되면 새 비밀번호를 설정할 수 있어요"
                android:textColor="@color/text_200"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp" />

            <!-- 이메일 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:hint="가입한 이메일을 입력하세요"
                        android:textColorHint="@color/text_200"
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:inputType="textEmailAddress"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="14dp" />

                    <!-- 코드 발송 결과 메시지 -->
                    <TextView
                        android:id="@+id/tv_email_check_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_send_code"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="코드 발송"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_primary_background"
                    android:minWidth="80dp" />

            </LinearLayout>

            <!-- 인증번호 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="인증번호"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="10dp">

                    <EditText
                        android:id="@+id/et_code"
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:hint="인증번호를 입력하세요"
                        android:textColorHint="@color/text_200"
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:inputType="number"
                        android:maxLength="6"
                        android:enabled="false"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="14dp" />

                    <!-- 인증번호 확인 결과 메시지 -->
                    <TextView
                        android:id="@+id/tv_verify_code_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- 인증번호 남은 시간 -->
                    <TextView
                        android:id="@+id/tv_verification_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                </LinearLayout>

                <Button
                    android:id="@+id/btn_verify_code"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:text="확인"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/button_primary_background"
                    android:minWidth="80dp"
                    android:enabled="false" />

            </LinearLayout>

            <!-- 새 비밀번호 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="새 비밀번호"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="7dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(8자 이상, 영문/숫자/특수문자 사용 가능)"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="7dp" />

            </LinearLayout>

            <EditText
                android:id="@+id/et_new_password"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="새 비밀번호를 입력하세요"
                android:textColorHint="@color/text_200"
                android:textColor="@color/text_100"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:enabled="false"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="18dp"
                android:maxLength="14" />

            <!-- 새 비밀번호 확인 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="새 비밀번호 확인"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="새 비밀번호를 다시 입력하세요"
                android:textColorHint="@color/text_200"
                android:textColor="@color/text_100"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:enabled="false"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="18dp"
                android:maxLength="14" />

            <!-- 비밀번호 일치 여부 실시간 표시 -->
            <TextView
                android:id="@+id/tv_password_match"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:layout_marginTop="-10dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone" />

            <!-- 비밀번호 재설정 버튼 -->
            <Button
                android:id="@+id/btn_reset_password"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:text="비밀번호 재설정"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:enabled="false"
                android:background="@drawable/button_primary_background"
                android:elevation="2dp"
                android:layout_marginBottom="16dp" />

            <!-- 하단 안내 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="비밀번호 재설정 후에는 다시 로그인해주세요"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
