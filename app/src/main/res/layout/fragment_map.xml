<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.MapFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_200">

        <!-- 상단 검색바 (캐치테이블 스타일) -->
        <LinearLayout
            android:id="@+id/header_search_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@color/white"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 뒤로가기 버튼 -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside" />

            <!-- 검색 입력 필드 -->
            <LinearLayout
                android:id="@+id/search_input_layout"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/search_bar_background"
                android:paddingHorizontal="12dp"
                android:layout_marginHorizontal="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_search_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="찾고 있는 맛집이 있나요?"
                    android:textColor="@color/text_200"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 날짜·인원 버튼 -->
            <LinearLayout
                android:id="@+id/btn_date_people"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/button_primary_background"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="날짜·인원"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- 카테고리 필터 버튼들 -->
        <HorizontalScrollView
            android:id="@+id/category_filter_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingVertical="12dp"
            android:paddingHorizontal="16dp"
            android:background="@color/white"
            android:elevation="2dp"
            app:layout_constraintTop_toBottomOf="@id/header_search_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_category_all"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="전체"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/category_button_active_background"
                    android:paddingHorizontal="18dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="0dp"/>

                <Button
                    android:id="@+id/btn_category_reservation"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="예약 9"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="18dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="0dp"/>

                <Button
                    android:id="@+id/btn_category_waiting"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="웨이팅 7"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="18dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="0dp"/>

                <Button
                    android:id="@+id/btn_category_pickup"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="픽업 0"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="18dp"
                    android:elevation="0dp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 지도 영역 (네이버 API가 여기 들어갈 예정) -->
        <FrameLayout
            android:id="@+id/map_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/category_filter_scroll"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/distance_filter_layout">

            <!-- 지도 플레이스홀더 (임시 배경) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E0E0E0" />

            <!-- 지도 위에 표시될 핀들 (나중에 네이버 API로 대체) -->
            <!-- 핀 예시 1 -->
            <FrameLayout
                android:id="@+id/pin_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:layout_marginStart="50dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🍖"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/map_pin_background"
                    android:elevation="4dp" />

            </FrameLayout>

            <!-- 핀 예시 2 -->
            <FrameLayout
                android:id="@+id/pin_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="150dp"
                android:layout_marginStart="180dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🍣"
                    android:textSize="28sp"
                    android:gravity="center"
                    android:background="@drawable/map_pin_inactive_background"
                    android:elevation="4dp" />

            </FrameLayout>

            <!-- 현재 위치 버튼 -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_current_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_location"
                app:fabSize="mini"
                android:backgroundTint="@color/white"
                app:tint="@color/primary_100"
                android:elevation="6dp" />

        </FrameLayout>

        <!-- 거리 필터 드롭다운 -->
        <LinearLayout
            android:id="@+id/distance_filter_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/white"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_filter_layout">

            <TextView
                android:id="@+id/tv_distance_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주변 1km"
                android:textColor="@color/text_100"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_down"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- 하단 필터 버튼들 -->
        <HorizontalScrollView
            android:id="@+id/bottom_filter_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="@color/white"
            android:elevation="4dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_detail_sheet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 추천순 버튼 -->
                <LinearLayout
                    android:id="@+id/btn_sort"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="추천순"
                        android:textColor="@color/text_200"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_down"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

                <!-- 필터 버튼 -->
                <LinearLayout
                    android:id="@+id/btn_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_filter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="필터"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:layout_marginStart="6dp" />

                </LinearLayout>

                <!-- 내 주변 버튼 (선택됨) -->
                <Button
                    android:id="@+id/btn_near_me"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="내 주변"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/category_button_active_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="0dp"/>

                <!-- 음식 종류 버튼 -->
                <Button
                    android:id="@+id/btn_food_type"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="음식 종류"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="0dp"/>

                <!-- 가격 버튼 -->
                <Button
                    android:id="@+id/btn_price"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="가격"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:background="@drawable/category_button_background"
                    android:paddingHorizontal="16dp"
                    android:elevation="0dp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- 하단 식당 상세 카드 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/bottom_detail_sheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- 식당 이미지 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_restaurant_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_home"
                        android:background="#FFE0E0" />

                </androidx.cardview.widget.CardView>

                <!-- 식당 정보 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical">

                    <!-- 식당 이름 -->
                    <TextView
                        android:id="@+id/tv_restaurant_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="테이킷스시 트레인 신풍점"
                        android:textColor="@color/text_100"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <!-- 평점 및 리뷰 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_star"
                            android:tint="@color/primary_100" />

                        <TextView
                            android:id="@+id/tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.1"
                            android:textColor="@color/text_100"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />

                        <TextView
                            android:id="@+id/tv_review_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(3)"
                            android:textColor="@color/text_200"
                            android:textSize="12sp"
                            android:layout_marginStart="2dp" />

                    </LinearLayout>

                    <!-- 카테고리 및 거리 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_category"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="신길·일식"
                            android:textColor="@color/text_200"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" · "
                            android:textColor="@color/text_200"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="내 위치에서 680m"
                            android:textColor="@color/text_200"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- 추가 정보 (영업시간, 가격 등) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <!-- 영업시간 태그 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏰ 오늘(월) 휴무"
                            android:textColor="@color/text_100"
                            android:textSize="11sp"
                            android:background="@drawable/category_button_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="6dp" />

                        <!-- 가격 태그 -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💰 1-2만원"
                            android:textColor="@color/text_100"
                            android:textSize="11sp"
                            android:background="@drawable/category_button_background"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
