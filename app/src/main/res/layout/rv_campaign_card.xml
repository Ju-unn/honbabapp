<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 상단 이미지 영역 ===== -->
        <!-- tv_deadline_badge 제거 — Issue #3 -->
        <ImageView
            android:id="@+id/iv_campaign_image"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/bg_300"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_meeting_image" />

        <!-- ===== 본문 영역 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- 제목 + 체험단 뱃지 (같은 라인, 뱃지 오른쪽) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_campaign_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="서울 강남 맛집 체험단 모집"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- 체험단 뱃지 (제목 오른쪽) -->
                <TextView
                    android:id="@+id/tv_campaign_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_primary_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="체험단"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 제공 내역 (핵심 정보 — 주황 굵게) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_food" />

                <TextView
                    android:id="@+id/tv_campaign_provided"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="2인 세트 무료 제공"
                    android:textColor="@color/primary_100"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 홍보 플랫폼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_campaign" />

                <TextView
                    android:id="@+id/tv_campaign_channels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="블로그 · 인스타그램"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 위치만 표시 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:id="@+id/tv_campaign_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="강남구 역삼동"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ===== 하단: 참여자 아바타 + 남은 인원 + 마감일 ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 참여자 아바타 3개 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_avatar_1"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/participant_avatar_background_1"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/iv_avatar_2"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="-8dp"
                        android:background="@drawable/participant_avatar_background_1"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/iv_avatar_3"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="-8dp"
                        android:background="@drawable/participant_avatar_background_1"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- 남은 모집 인원 -->
                <TextView
                    android:id="@+id/tv_campaign_participant_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="+2명 더 모집중"
                    android:textColor="@color/primary_200"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- 모집 마감일 -->
                <TextView
                    android:id="@+id/tv_campaign_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~07/31 마감"
                    android:textColor="@color/accent_100"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>