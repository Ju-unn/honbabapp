<?xml version="1.0" encoding="utf-8"?>
<!-- 이 동네에 모임이 0건일 때 표시. HomeFragment에서 목록 0건 분기로 토글. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="36dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="이 동네 모임"
        android:textColor="@color/text_100"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="16dp" />

    <!-- 빈상태 카드 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/empty_card_background"
        android:layout_marginHorizontal="18dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="32dp">

        <!-- 앱 로고 -->
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/app_logo2"
            android:layout_marginBottom="20dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아직 이 동네에 모임이 없어요"
            android:textColor="@color/text_100"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="첫 모임을 만들어 이웃과 함께 식사해 보세요.\n다른 동네를 둘러볼 수도 있어요."
            android:textColor="@color/text_200"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

</LinearLayout>
