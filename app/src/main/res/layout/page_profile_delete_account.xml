<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="계정 탈퇴"
            android:textColor="@color/error_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="42dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 경고 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFEBEE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="정말 탈퇴하시겠어요?"
                            android:textColor="@color/error_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="탈퇴하면 닉네임, 프로필 사진등 프로필 정보가 삭제되고\n채팅방에서 제외됩니다.\n승인된 모임에 참여 중이거나 \n모집 중인 모임의 호스트라면 먼저 모임을 나가거나 삭제해야 탈퇴할 수 있어요."
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 삭제되는 정보 목록 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제되는 정보"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bg_100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 프로필 정보 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="프로필 정보 (닉네임, 프로필 사진 등)"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- 대기 중인 모임 참여 신청 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="승인 대기 중인 모임 참여 신청 (자동 취소)"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 유지되는 정보 목록 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="유지되는 정보"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bg_100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/text_200"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="매너 점수 및 완료된 모임 참여·리뷰 이력"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/text_200"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="전화번호, 성별, 생년월일, 지역 정보"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 재가입 시 복구 안내 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:text="1년간 탈퇴 후 동일한 카카오/구글 계정 또는 이메일로 재가입하면 위 유지 정보와 함께 계정이 복구될 수 있습니다."
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

            <!-- 탈퇴 사유 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="탈퇴 사유 (선택)"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radio_group_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radio_reason_1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="서비스를 잘 이용하지 않아요"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:drawableTint="@color/radio_tint"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_reason_2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="원하는 모임을 찾기 어려워요"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:drawableTint="@color/radio_tint"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_reason_3"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="앱 사용이 불편해요"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:drawableTint="@color/radio_tint"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_reason_4"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="기타"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:drawableTint="@color/radio_tint" />

            </RadioGroup>

            <!-- 기타 사유 입력 -->
            <EditText
                android:id="@+id/et_other_reason"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="탈퇴 사유를 입력해 주세요 (선택)"
                android:textColorHint="@color/text_200"
                android:textColor="@color/text_100"
                android:textSize="14sp"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLength="200"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <!-- 동의 체크박스 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- 로그인 화면 CheckBox와 동일하게 기본 체크박스(오렌지 틴트) 사용 -->
                <CheckBox
                    android:id="@+id/checkbox_agree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위 내용을 확인했으며, 탈퇴에 동의합니다."
                    android:textColor="@color/text_100"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:orientation="horizontal"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/Widget.Honbab.Button.Outline"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="취소"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_delete_account"
            style="@style/Widget.Honbab.Button.Danger"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="탈퇴하기"
            android:enabled="false"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>