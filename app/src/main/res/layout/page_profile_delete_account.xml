<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="계정 탈퇴"
            android:textColor="@color/error_red"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="42dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 경고 카드 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFEBEE">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="정말 탈퇴하시겠어요?"
                            android:textColor="@color/error_red"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="계정을 탈퇴하면 아래 정보가 모두 삭제되며,\n복구가 불가능합니다."
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 삭제되는 정보 목록 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="삭제되는 정보"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bg_100">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- 프로필 정보 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="프로필 정보 (닉네임, 프로필 사진 등)"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- 모임 기록 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="참여한 모임 기록"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- 채팅 내역 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="채팅 내역"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- 리뷰 및 평가 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@color/error_red"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="리뷰 및 평가 기록"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 탈퇴 사유 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="탈퇴 사유 (선택)"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radio_group_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/radio_reason_1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="서비스를 잘 이용하지 않아요"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_reason_2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="원하는 모임을 찾기 어려워요"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_reason_3"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="앱 사용이 불편해요"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/radio_reason_4"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="기타"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:paddingStart="8dp"
                    android:background="@drawable/radiobutton_category_background"
                    android:button="@null"
                    android:drawableEnd="?android:attr/listChoiceIndicatorSingle" />

            </RadioGroup>

            <!-- 기타 사유 입력 -->
            <EditText
                android:id="@+id/et_other_reason"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="탈퇴 사유를 입력해 주세요 (선택)"
                android:textColorHint="@color/text_200"
                android:textColor="@color/text_100"
                android:textSize="14sp"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLength="200"
                android:visibility="gone"
                android:layout_marginBottom="24dp" />

            <!-- 동의 체크박스 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <CheckBox
                    android:id="@+id/checkbox_agree"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:button="@null"
                    android:background="@drawable/checkbox_background" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위 내용을 확인했으며, 탈퇴에 동의합니다."
                    android:textColor="@color/text_100"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:orientation="horizontal"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="취소"
            android:textColor="@color/text_100"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_outline_background"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_delete_account"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="탈퇴하기"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_danger_background"
            android:enabled="false"
            android:alpha="0.5"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>