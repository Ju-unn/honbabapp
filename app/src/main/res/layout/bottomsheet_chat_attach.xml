<?xml version="1.0" encoding="utf-8"?>
<!--
    채팅 이미지 첨부 바텀시트 (카카오톡 스타일)
    - 상단 : 드래그 핸들 (강퇴 바텀시트와 동일한 톤)
    - 본문 : 좌(갤러리) / 우(카메라) 1행 2열 그리드
            └ 원형 컬러 배경 위 흰색 아이콘 + 아래 라벨
    - 가장자리 ripple 효과로 터치 피드백 제공
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_100"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- 드래그 핸들 (강퇴 바텀시트와 동일) -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@color/gray_border" />

    <!-- 그리드 영역 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp"
        android:weightSum="4">

        <!-- ───────── 갤러리 ───────── -->
        <LinearLayout
            android:id="@+id/btn_pick_gallery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <!-- 원형 배경 + 흰색 아이콘 -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_gallery">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_attach_gallery"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="갤러리"
                android:textColor="@color/text_100"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ───────── 카메라 ───────── -->
        <LinearLayout
            android:id="@+id/btn_pick_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <!-- 원형 배경 + 흰색 아이콘 -->
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_attach_camera">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_attach_camera"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- 라벨 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="카메라"
                android:textColor="@color/text_100"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>