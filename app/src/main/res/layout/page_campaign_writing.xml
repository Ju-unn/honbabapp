<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_200"
    android:orientation="vertical">
    <!--  상단 헤더  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@color/white"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:text="체험단 등록"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <!--  ========== 1. 사진 미리보기 ==========  -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <LinearLayout
                        android:id="@+id/layout_photo_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/photo_upload_background"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="📸"
                            android:textSize="40sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="가게를 선택하면 사진이 자동으로 채워져요"
                            android:textColor="@color/text_200"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_campaign_photo_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
            <!--  ========== 2. 가게 찾기 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="가게 찾기"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_store_search"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="2"
                        android:background="@drawable/edittext_background"
                        android:hint="가게명 또는 주소 입력"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_100"
                        android:textColorHint="@color/text_200"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_search_store"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_primary_background"
                        android:minWidth="0dp"
                        android:text="검색"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <!--  ========== 3. 선택된 가게 정보 ==========  -->
            <androidx.cardview.widget.CardView
                android:id="@+id/selected_store_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/bg_300"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="선택된 가게"
                        android:textColor="@color/text_200"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_selected_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="가게 주소"
                        android:textColor="@color/text_200"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_selected_store_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!--  ========== 4. 카테고리 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="카테고리"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_category_korean"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:checked="true"
                            android:gravity="center"
                            android:text="🍚 한식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radio_category_chinese"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="🥟 중식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radio_category_japanese"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="🍣 일식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radio_category_western"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="🍔 양식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_category_omakase"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="🍱 오마카세"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radio_category_cafe"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="☕ 카페"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radio_category_pub"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/radiobutton_category_background"
                            android:button="@null"
                            android:gravity="center"
                            android:text="🍺 술집"
                            android:textColor="@color/text_100"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <!--  ========== 5. 체험단명 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="체험단명"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_campaign_title"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_background"
                    android:hint="체험단 제목을 입력하세요"
                    android:inputType="text"
                    android:maxLength="30"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_100"
                    android:textColorHint="@color/text_200"
                    android:textSize="15sp" />
            </LinearLayout>
            <!--  ========== 6. 체험단 설명 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="체험단 설명"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_campaign_description"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/edittext_background"
                    android:gravity="top"
                    android:hint="체험단 공고에 대해 간단히 소개해 주세요"
                    android:inputType="textMultiLine"
                    android:maxLength="200"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/text_100"
                    android:textColorHint="@color/text_200"
                    android:textSize="15sp" />
            </LinearLayout>
            <!-- 7. 방문 날짜 — 삭제 (채팅으로 조율) -->
            <!-- 8. 방문 희망 시간 — 삭제 (채팅으로 조율) -->
            <!--  ========== 9. 모집 인원 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="모집 인원"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_decrease_count"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/count_button_background"
                        android:contentDescription="인원 감소"
                        android:scaleType="center"
                        android:src="@drawable/ic_minus" />

                    <TextView
                        android:id="@+id/tv_participant_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="2명"
                        android:textColor="@color/text_100"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_increase_count"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/count_button_background"
                        android:contentDescription="인원 증가"
                        android:scaleType="center"
                        android:src="@drawable/ic_plus" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="최소 2명 ~ 최대 20명"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />
            </LinearLayout>
            <!--  ========== 10. 가격대 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="자부담 가격"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_price_range_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="10,000원 ~ 20,000원"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/range_slider_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5000"
                    android:valueFrom="0"
                    android:valueTo="100000"
                    app:labelBehavior="gone"
                    app:values="@array/initial_price_range" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0원"
                        android:textColor="@color/text_100"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100,000원"
                        android:textColor="@color/text_100"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
            <!--  ========== 체험단 전용 구분선 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/primary_100" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="체험단 정보"
                    android:textColor="@color/primary_200"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <!--  ========== 11. 홍보 플랫폼 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="홍보 플랫폼"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="필수"
                        android:textColor="@color/error_red"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/checkbox_channel_blog"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/radiobutton_category_background"
                        android:button="@null"
                        android:gravity="center"
                        android:text="블로그"
                        android:textColor="@color/text_100"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/checkbox_channel_instagram"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/radiobutton_category_background"
                        android:button="@null"
                        android:gravity="center"
                        android:text="인스타"
                        android:textColor="@color/text_100"
                        android:textSize="13sp" />

                    <CheckBox
                        android:id="@+id/checkbox_channel_youtube"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/radiobutton_category_background"
                        android:button="@null"
                        android:gravity="center"
                        android:text="유튜브"
                        android:textColor="@color/text_100"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
            <!--  ========== 12. 제공 내역 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="제공 내역"
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="필수"
                        android:textColor="@color/error_red"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_campaign_provided"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/edittext_background"
                    android:gravity="top"
                    android:hint="제공 내역을 입력하세요 (예: 2인 세트 무료 제공)"
                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/text_100"
                    android:textColorHint="@color/text_200"
                    android:textSize="15sp" />
            </LinearLayout>
            <!--  ========== 13. 신청 조건 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="신청 조건 (선택)"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_campaign_requirements"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:background="@drawable/edittext_background"
                    android:gravity="top"
                    android:hint="신청 조건을 입력하세요 (예: 사진 몇개 넣기 , 영상길이 등)"
                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/text_100"
                    android:textColorHint="@color/text_200"
                    android:textSize="15sp" />
            </LinearLayout>
            <!--  ========== 14. 모집 마감일 ==========  -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="모집 마감일 (선택)"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_campaign_deadline"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/edittext_background"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawablePadding="12dp"
                    android:focusable="false"
                    android:hint="마감일을 선택해주세요"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/text_100"
                    android:textColorHint="@color/text_200"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <!--  하단 고정 버튼  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:elevation="4dp"
        android:padding="18dp">

