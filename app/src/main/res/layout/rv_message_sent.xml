<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- 왼쪽 여백 -->
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.3" />

    <!-- 실패 시: 재전송/삭제 버튼 -->
    <LinearLayout
        android:id="@+id/failOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginEnd="6dp"
        android:visibility="gone">

        <!-- 흰 둥근 컨테이너 안에 아이콘 2개 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fail_action"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            >

            <!-- 재전송 -->
            <ImageButton
                android:id="@+id/btnRetry"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="재전송"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_rotate"
                app:tint="#FF8A30" />

            <!-- 가운데 구분 여백 -->
            <View
                android:layout_width="14dp"
                android:layout_height="match_parent" />

            <!-- 삭제 -->
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="삭제"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FF8A30" />

        </LinearLayout>

    </LinearLayout>

    <!-- 시간 + 읽음: 말풍선 왼쪽, 하단 정렬 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/textUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text=""
            android:textColor="@color/accent_100"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text=""
            android:textColor="@color/text_200"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- 말풍선 컨테이너 -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- 텍스트 말풍선 -->
        <TextView
            android:id="@+id/textContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_bubble_sent"
            android:maxWidth="250dp"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- 단일 이미지 -->
        <ImageView
            android:id="@+id/imageContent"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/message_image_background"
            android:clipToOutline="true"
            android:contentDescription="채팅 이미지"
            android:maxHeight="280dp"
            android:minHeight="120dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- 다중 이미지 그리드 (2장 이상일 때) -->
        <com.example.honbabapp.ui.view.ChatImageGridView
            android:id="@+id/imageGrid"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:background="@drawable/message_image_background"
            android:clipToOutline="true"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>