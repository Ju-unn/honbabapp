<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- 왼쪽 여백 -->
    <View
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.3" />

    <!-- 시간 + 읽음: 말풍선 왼쪽, 하단 정렬 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="2dp">

        <!-- 읽지 않은 수 -->
        <TextView
            android:id="@+id/textUnread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text=""
            android:textColor="@color/accent_100"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- 전송 시간 -->
        <TextView
            android:id="@+id/textTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text=""
            android:textColor="@color/text_200"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- 말풍선 컨테이너: 텍스트 또는 이미지 한 가지만 보임 -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <!-- 텍스트 메시지 말풍선 -->
        <TextView
            android:id="@+id/textContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/message_bubble_sent"
            android:maxWidth="250dp"
            android:padding="12dp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- 이미지 메시지 (둥근 모서리) -->
        <ImageView
            android:id="@+id/imageContent"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/message_image_background"
            android:clipToOutline="true"
            android:contentDescription="채팅 이미지"
            android:maxHeight="280dp"
            android:minHeight="120dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>