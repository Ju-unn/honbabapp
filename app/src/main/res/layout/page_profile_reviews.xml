<?xml version="1.0" encoding="utf-8"?>
<!-- 내 리뷰 화면 (page_profile_my_meetings.xml 과 동일 패턴: TabLayout + RecyclerView 1개) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/bg_100"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/page_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="내 리뷰"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_200"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="56dp"
            android:layout_marginStart="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 구분선 -->
    <View
        android:id="@+id/divider_header"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/border_100"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 탭 레이아웃 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/primary_100"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/primary_100"
        app:tabTextColor="@color/text_200"
        app:layout_constraintTop_toBottomOf="@id/divider_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="받은 리뷰" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="내가 쓴 리뷰" />

    </com.google.android.material.tabs.TabLayout>

    <!-- 탭 구분선 -->
    <View
        android:id="@+id/divider_tab"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/border_100"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 리뷰 리스트 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reviews"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:background="@color/bg_100"
        app:layout_constraintTop_toBottomOf="@id/divider_tab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 빈 상태 레이아웃 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/empty_state_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg_100"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/divider_tab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/empty_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐"
            android:textSize="48sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/empty_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아직 리뷰가 없어요"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_100"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/empty_icon"
            app:layout_constraintBottom_toTopOf="@id/empty_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/empty_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="모임에 참여하고\n후기를 주고받아 보세요!"
            android:textSize="14sp"
            android:textColor="@color/text_200"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintTop_toBottomOf="@id/empty_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
