<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="모임 생성"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="56dp"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- ========== 1. 사진 미리보기 ========== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="200dp">

                    <!-- 사진 없을 때 placeholder (가게 선택 전) -->
                    <LinearLayout
                        android:id="@+id/layout_photo_placeholder"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/photo_upload_background">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📸"
                            android:textSize="40sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="가게를 선택하면 사진이 자동으로 채워져요"
                            android:textColor="@color/text_200"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <!-- 가게 선택 후 자동으로 채워지는 사진 (기본: gone) -->
                    <ImageView
                        android:id="@+id/iv_meeting_photo_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="gone"/>

                </FrameLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========== 2. 가게 찾기 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가게 찾기"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_store_search"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="2"
                        android:hint="가게명 또는 주소 입력"
                        android:textColorHint="@color/text_200"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:background="@drawable/edittext_background"
                        android:paddingHorizontal="16dp"
                        android:layout_marginEnd="8dp"
                        android:inputType="text" />

                    <Button
                        android:id="@+id/btn_search_store"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:text="검색"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_primary_background"
                        android:minWidth="0dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ========== 3. 선택된 가게 정보 (검색 후 나타남) ========== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/selected_store_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/bg_300">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="선택된 가게"
                        android:textColor="@color/text_200"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_selected_store"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="돼지 먹고 싶은날"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="가게 주소"
                        android:textColor="@color/text_200"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_selected_store_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="신림동 108-00번지"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ========== 4. 카테고리 선택 (RadioButton 방식) ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="카테고리"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 첫 번째 줄: 한식, 중식, 일식, 양식 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <RadioButton
                            android:id="@+id/radio_category_korean"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="🍚 한식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:checked="true"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginEnd="6dp"/>

                        <RadioButton
                            android:id="@+id/radio_category_chinese"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="🥟 중식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginHorizontal="3dp"/>

                        <RadioButton
                            android:id="@+id/radio_category_japanese"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="🍣 일식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginHorizontal="3dp"/>

                        <RadioButton
                            android:id="@+id/radio_category_western"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="🍔 양식"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                    <!-- 두 번째 줄: 오마카세, 카페, 술집 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_category_omakase"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="🍱 오마카세"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginEnd="6dp"/>

                        <RadioButton
                            android:id="@+id/radio_category_cafe"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="☕ 카페"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginHorizontal="3dp"/>

                        <RadioButton
                            android:id="@+id/radio_category_pub"
                            android:layout_width="0dp"
                            android:layout_height="45dp"
                            android:layout_weight="1"
                            android:text="🍺 술집"
                            android:textColor="@color/text_100"
                            android:textSize="14sp"
                            android:button="@null"
                            android:gravity="center"
                            android:background="@drawable/radiobutton_category_background"
                            android:layout_marginHorizontal="3dp"/>

                        <!-- 빈 공간 (정렬용) -->
                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ========== 5. 모임명 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모임명"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_meeting_title"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="모임명을 입력하세요"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:maxLength="30"
                    android:inputType="text"/>

            </LinearLayout>

            <!-- ========== 6. 모임 설명 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모임 설명"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_meeting_description"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="모임에 대해 간단히 소개해 주세요"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:gravity="top"
                    android:maxLength="100"
                    android:inputType="textMultiLine"/>

            </LinearLayout>

            <!-- ========== 7. 날짜 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모임 만나는 날짜"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_meeting_date"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="날짜를 선택해주세요"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawablePadding="12dp"/>

            </LinearLayout>

            <!-- ========== 8. 시간 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모임 만나는 시간"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/et_meeting_time"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="시간을 선택해주세요 (예: 19:00)"
                    android:textColorHint="@color/text_200"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:background="@drawable/edittext_background"
                    android:paddingHorizontal="16dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_clock"
                    android:drawablePadding="12dp"/>

            </LinearLayout>

            <!-- ========== 9. 모집 인원 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모집 인원"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btn_decrease_count"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_minus"
                        android:scaleType="center"
                        android:background="@drawable/count_button_background"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="인원 감소"/>

                    <TextView
                        android:id="@+id/tv_participant_count"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2명"
                        android:textColor="@color/text_100"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <ImageButton
                        android:id="@+id/btn_increase_count"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_plus"
                        android:scaleType="center"
                        android:background="@drawable/count_button_background"
                        android:layout_marginStart="12dp"
                        android:contentDescription="인원 증가"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="최소 2명 ~ 최대 20명"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- ========== 10. 가격대 선택 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="가격대"
                    android:textSize="13sp"
                    android:textColor="@color/text_200"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_price_range_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10,000원 ~ 20,000원"
                    android:textSize="11sp"
                    android:textColor="@color/text_200"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/range_slider_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100000"
                    android:stepSize="5000"
                    app:values="@array/initial_price_range"
                    app:labelBehavior="gone"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0원"
                        android:textSize="12sp"
                        android:textColor="@color/text_100"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100,000원"
                        android:textSize="12sp"
                        android:textColor="@color/text_100"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 고정 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_create_meeting"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="모임 생성"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_background"
            android:elevation="2dp"/>

    </LinearLayout>

</LinearLayout>