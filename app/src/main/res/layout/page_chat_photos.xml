<?xml version="1.0" encoding="utf-8"?>
<!--
    채팅방 사진 전체보기 페이지
    - 상단 헤더 (← 뒤로가기 + "사진")
    - 3열 그리드 RecyclerView
    - 빈 상태 placeholder
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <!-- 뒤로가기 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp"
            android:contentDescription="뒤로가기" />

        <!-- 제목 "사진" -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="사진"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="56dp" />

    </LinearLayout>

    <!-- 3열 그리드 RecyclerView -->
    <!-- LayoutManager 는 Java에서 GridLayoutManager(this, 3) 으로 설정 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat_photos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="2dp"
        android:paddingTop="2dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <!-- 빈 상태 -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전송된 사진이 없습니다"
            android:textColor="@color/text_200"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>