<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notification_item_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/notification_item_background"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:gravity="top"
    android:clickable="true"
    android:focusable="true">

    <!-- 알림 아이콘 영역 -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp">

        <!-- 아이콘 배경 -->
        <View
            android:id="@+id/icon_background"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/notification_icon_background" />

        <!-- 알림 아이콘 -->
        <ImageView
            android:id="@+id/iv_notification_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_bell_menu"
            app:tint="@color/primary_100" />

    </FrameLayout>

    <!-- 알림 내용 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 알림 제목 -->
        <TextView
            android:id="@+id/tv_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="새로운 모임 초대"
            android:textColor="@color/text_100"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <!-- 알림 내용 -->
        <TextView
            android:id="@+id/tv_notification_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="홍길동님이 '맛있는 삼겹살 모임'에 초대했습니다."
            android:textColor="@color/text_200"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="6dp" />

        <!-- 시간 및 태그 영역 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 알림 시간 -->
            <TextView
                android:id="@+id/tv_notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="방금 전"
                android:textColor="@color/text_200"
                android:textSize="11sp" />

            <!-- 구분점 -->
            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="8dp" />

            <!-- 알림 타입 태그 -->
            <TextView
                android:id="@+id/tv_notification_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모임"
                android:textColor="@color/primary_100"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/notification_tag_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 읽지 않음 표시 (점) -->
    <View
        android:id="@+id/unread_indicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/notification_badge_background"
        android:visibility="visible" />

</LinearLayout>