<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_100"
        android:orientation="vertical">

        <!-- ===== 드래그 핸들 ===== -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:background="@color/bg_300" />

        <!-- ===== 헤더: 닉네임 + 닫기 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tv_sheet_nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="신청자 정보"
                android:textColor="@color/text_100"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:src="@drawable/ic_close" />

        </LinearLayout>

        <!-- ===== 구분선 ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_100" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <!-- ===== 프로필 요약 행 ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_sheet_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="14dp"
                        android:background="@android:color/transparent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_profile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_sheet_nickname_detail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:text="닉네임"
                            android:textColor="@color/text_100"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <!-- 매너점수 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_sheet_manner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="매너점수 36.5°C"
                                android:textColor="@color/primary_100"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 신청 시간 -->
                    <TextView
                        android:id="@+id/tv_sheet_apply_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10분 전"
                        android:textColor="@color/text_200"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- ===== 구분선 ===== -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/bg_200" />

                <!-- ===== SNS 계정 ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.05"
                        android:text="SNS 계정"
                        android:textColor="@color/text_200"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="클릭시 이동합니다"
                        android:textColor="@color/primary_200"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- 인스타그램 -->
                <LinearLayout
                    android:id="@+id/layout_sheet_instagram"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/readonly_field_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="인스타그램"
                        android:textColor="@color/text_200"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_sheet_instagram_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="—"
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 블로그 -->
                <LinearLayout
                    android:id="@+id/layout_sheet_blog"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/readonly_field_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="블로그"
                        android:textColor="@color/text_200"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_sheet_blog_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="—"
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- 유튜브 -->
                <LinearLayout
                    android:id="@+id/layout_sheet_youtube"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/readonly_field_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="유튜브"
                        android:textColor="@color/text_200"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_sheet_youtube_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="—"
                        android:textColor="@color/text_100"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- ===== 자기소개 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.05"
                    android:text="자기소개"
                    android:textColor="@color/text_200"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/readonly_field_background"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tv_sheet_intro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.5"
                        android:text="자기소개 없음"
                        android:textColor="@color/text_100"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- ===== 받은 리뷰 ===== -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.05"
                    android:text="받은 리뷰"
                    android:textColor="@color/text_200"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sheet_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <TextView
                    android:id="@+id/tv_sheet_no_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/readonly_field_background"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="아직 받은 리뷰가 없어요"
                    android:textColor="@color/text_200"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_sheet_load_more_reviews"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:minHeight="0dp"
                    android:text="더보기"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:visibility="gone" />

                <!-- 승인/거절 버튼 제거됨 — 아이템의 버튼으로 처리 -->

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>