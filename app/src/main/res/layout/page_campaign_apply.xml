<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="체험단 신청"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:layout_marginEnd="42dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 안내 배너 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SNS 계정 정보는 프로필에 저장된 값이 자동으로 사용됩니다."
                    android:textColor="@color/primary_200"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.4" />

            </LinearLayout>

            <!-- ========== SNS 계정 정보 (읽기 전용 prefill) ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_100"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 SNS 계정"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- 인스타그램 ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="인스타그램 ID"
                            android:textColor="@color/text_200"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_instagram_edit_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="프로필에서 수정"
                            android:textColor="@color/primary_100"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/edittext_readonly_background"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/text_200"
                            android:textSize="15sp"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_instagram_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="인스타그램 ID를 등록해주세요"
                            android:textColor="@color/text_200"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 블로그 ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="블로그 ID"
                            android:textColor="@color/text_200"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_blog_edit_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="프로필에서 수정"
                            android:textColor="@color/primary_100"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/edittext_readonly_background"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tv_blog_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="블로그 ID를 등록해주세요"
                            android:textColor="@color/text_200"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 유튜브 ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="유튜브 ID"
                            android:textColor="@color/text_200"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_youtube_edit_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="프로필에서 수정"
                            android:textColor="@color/primary_100"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/edittext_readonly_background"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:id="@+id/tv_youtube_id"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="유튜브 ID를 등록해주세요 (선택)"
                            android:textColor="@color/text_200"
                            android:textSize="15sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- ========== 자기소개 (매번 새로 입력) ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_100"
                android:padding="18dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="자기소개"
                        android:textColor="@color/text_100"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="필수"
                        android:textColor="@color/error_red"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SNS 채널의 특징, 팔로워 수, 활동 내용 등을 간략히 소개해 주세요."
                    android:textColor="@color/text_200"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/et_applicant_intro"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:background="@drawable/edittext_background"
                    android:gravity="top"
                    android:hint="예: 음식 전문 인스타 운영 중, 팔로워 2,000명, 월 5회 이상 포스팅합니다."
                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:textColor="@color/text_100"
                    android:textColorHint="@color/text_200"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_intro_char_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 / 500"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:gravity="end"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- ========== 신청 안내 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_100"
                android:padding="18dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="신청 안내"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@color/text_200"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="신청 후 호스트의 승인이 있어야 체험단 참여가 확정됩니다."
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@color/text_200"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="호스트와 1:1 채팅으로 일정 및 방문 방식을 협의할 수 있습니다."
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@color/text_200"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SNS 계정이 없다면 프로필에서 먼저 등록해 주세요."
                        android:textColor="@color/text_200"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.4" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 하단 고정 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btn_submit_apply"
            style="@style/Widget.Honbab.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="신청하기"
            android:textSize="16sp"
            android:elevation="2dp" />

    </LinearLayout>

</LinearLayout>