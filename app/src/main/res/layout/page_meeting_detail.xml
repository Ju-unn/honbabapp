<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_200">

    <!--    상단 헤더-->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- 뒤로가기 버튼 -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <!-- 제목 -->
        <TextView
            android:id="@+id/tv_store_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="삼겹살 모임"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:maxLines="1"
            android:ellipsize="end"/>


        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btn_more_options"
                android:layout_width="35dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_3bar"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </FrameLayout>



    </LinearLayout>

    <!--    스크롤-->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/join_button_container">

        <!--        스크롤 내용 구성-->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--            모임 이미지-->
            <FrameLayout
                android:id="@+id/image_container"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:background="@color/bg_300"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_meeting_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_meeting_image" />

            </FrameLayout>

            <!--            가게 이름-->
            <TextView
                android:id="@+id/tv_meeting_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="강남 삽겹살집"
                android:textColor="@color/text_100"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toBottomOf="@+id/image_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/rating_container"/>

            <!-- 평점 -->
            <LinearLayout
                android:id="@+id/rating_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toTopOf="@id/tv_meeting_title"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_store_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.8"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="2dp" />

            </LinearLayout>

            <!--            가게 카테고리-->
            <TextView
                android:id="@+id/tv_store_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="한식 • 고기구이"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_meeting_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--            가게 주소-->
            <TextView
                android:id="@+id/tv_store_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="서울 강남구 강남대로 123길 231"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_store_category"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!--            가격 정보-->
            <TextView
                android:id="@+id/tv_price_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1인당 25,000원 ~ 35,000원"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_store_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- 구분선 1 -->
            <View
                android:id="@+id/divider_1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_price_range"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!--            모임 정보 제목-->
            <TextView
                android:id="@+id/tv_meeting_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="모임 정보"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/divider_1"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- 첫 번째 가이드라인 (33%) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.33" />

            <!-- 두 번째 가이드라인 (66%) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_66"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.66" />

            <!-- 날짜 아이콘 -->
            <ImageView
                android:id="@+id/iv_meeting_date"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_meeting_info_title"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- 날짜 텍스트 -->
            <TextView
                android:id="@+id/tv_meeting_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="7월 15일"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_meeting_date"
                app:layout_constraintBottom_toBottomOf="@id/iv_meeting_date"
                app:layout_constraintStart_toEndOf="@id/iv_meeting_date"
                app:layout_constraintEnd_toStartOf="@id/guideline_33" />

            <!-- 시간 아이콘 -->
            <ImageView
                android:id="@+id/iv_meeting_time"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_meeting_date"
                app:layout_constraintStart_toStartOf="@id/guideline_33"/>

            <!-- 시간 텍스트 -->
            <TextView
                android:id="@+id/tv_meeting_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="오후 7:00"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_meeting_date"
                app:layout_constraintBottom_toBottomOf="@id/iv_meeting_date"
                app:layout_constraintStart_toEndOf="@id/iv_meeting_time"
                app:layout_constraintEnd_toStartOf="@id/guideline_66" />

            <!-- 참여자 아이콘 -->
            <ImageView
                android:id="@+id/iv_participant_count"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_user"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_meeting_date"
                app:layout_constraintStart_toStartOf="@id/guideline_66"/>

            <!-- 참여자 텍스트 -->
            <TextView
                android:id="@+id/tv_participant_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="2/4명"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toTopOf="@id/iv_meeting_date"
                app:layout_constraintBottom_toBottomOf="@id/iv_meeting_date"
                app:layout_constraintStart_toEndOf="@id/iv_participant_count"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- 구분선 2 -->
            <View
                android:id="@+id/divider_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_participant_count"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 호스트 메시지 제목 -->
            <TextView
                android:id="@+id/tv_host_message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="호스트 메시지"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_2"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 호스트 메시지 내용 -->
            <TextView
                android:id="@+id/tv_host_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="회사 근처에서 맛있는 삼겹살 먹고 싶어요! 같이 드실 분들 환영합니다 😊 처음 오시는 분들도 편하게 참여해주세요!"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_host_message_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 구분선 3 -->
            <View
                android:id="@+id/divider_3"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_host_message"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 위치 제목 -->
            <TextView
                android:id="@+id/tv_location_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_3"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 미니 지도 -->
            <com.naver.maps.map.MapView
                android:id="@+id/mini_map"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_location_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 구분선 4 -->
            <View
                android:id="@+id/divider_4"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/mini_map"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 참여자 제목 -->
            <TextView
                android:id="@+id/tv_participants_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="참여자 (2/4)"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_4"
                app:layout_constraintStart_toStartOf="parent" />


            <!-- 참여자 RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_participants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tv_participants_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- 하단 고정 버튼 -->
    <LinearLayout
        android:id="@+id/join_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_join_meeting"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="참여 신청하기"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_background"
            android:elevation="2dp" />

    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>