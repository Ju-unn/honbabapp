<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 장소명 -->
        <TextView
            android:id="@+id/tv_place_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="돼지 먹고 싶은날"
            android:textSize="16sp"
            android:textColor="@color/text_100"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 카테고리 -->
        <TextView
            android:id="@+id/tv_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="음식점 > 한식 > 삼겹살"
            android:textSize="12sp"
            android:textColor="@color/primary_200"
            android:layout_marginTop="4dp" />

        <!-- 도로명 주소 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_road_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="서울특별시 관악구 신림로 108"
                android:textSize="13sp"
                android:textColor="@color/text_200"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 지번 주소 -->
        <TextView
            android:id="@+id/tv_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(신림동 108-00)"
            android:textSize="12sp"
            android:textColor="@color/text_200"
            android:layout_marginTop="2dp"
            android:layout_marginStart="20dp" />

        <!-- 전화번호 -->
        <LinearLayout
            android:id="@+id/layout_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02-1234-5678"
                android:textSize="13sp"
                android:textColor="@color/text_200" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>