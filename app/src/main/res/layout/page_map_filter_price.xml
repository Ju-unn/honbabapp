<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 📌 제목 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="가격대"
        android:textColor="@color/text_100"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <!-- 📌 RangeSlider (Material 1.9.0 호환) -->
    <com.google.android.material.slider.RangeSlider
        android:id="@+id/price_range_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="50000.0"
        android:stepSize="1000.0"
        app:values="@array/initial_price_range"
        app:trackColorActive="@color/primary_100"
        app:trackColorInactive="@color/bg_200"
        app:thumbColor="@color/primary_100"
        app:thumbRadius="12dp"
        app:trackHeight="4dp"
        android:layout_marginBottom="16dp" />

    <!-- 📌 선택된 가격 범위 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_min_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0원"
            android:textColor="@color/text_100"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ~ "
            android:textColor="@color/text_200"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_max_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50,000원"
            android:textColor="@color/text_100"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 📌 빠른 선택 버튼 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="빠른 선택"
        android:textColor="@color/text_200"
        android:textSize="14sp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_price_under_10k"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="1만원 이하"
            android:textSize="12sp"
            android:textColor="@color/text_100"
            android:background="@drawable/button_secondary_background"
            android:backgroundTint="@null"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_price_10k_20k"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="1만~2만원"
            android:textSize="12sp"
            android:textColor="@color/text_100"
            android:background="@drawable/button_secondary_background"
            android:backgroundTint="@null"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_price_20k_30k"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="2만~3만원"
            android:textSize="12sp"
            android:textColor="@color/text_100"
            android:background="@drawable/button_secondary_background"
            android:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>