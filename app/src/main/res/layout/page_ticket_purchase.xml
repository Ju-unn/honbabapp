<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_100">

    <!-- ── 상단 바 ─────────────────────────────────────────── -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="뒤로가기"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_right"
        android:rotation="180"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvScreenTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="체험단 등록권 구매"
        android:textColor="@color/text_100"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- ── 스크롤 영역 (상품 선택 + 결제위젯) ───────────────── -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomAction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="체험단 목록 등록에는 등록권이 필요해요"
                android:textColor="@color/text_100"
                android:textSize="14sp" />

            <!-- 상품 선택 옵션 (기존 RadioGroup → LinearLayout으로 교체됨.
                 RadioButton이 MaterialCardView 안쪽에 중첩되어 있어 RadioGroup의
                 상호 배타 처리/콜백이 애초에 동작하지 않았기 때문. 클릭 처리는
                 TicketPurchaseActivity.selectTicketProduct()에서 직접 담당한다. -->
            <LinearLayout
                android:id="@+id/layoutTicketProductOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- 1회 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTicket1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@null"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_100"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1회 등록권"
                                android:textColor="@color/text_100"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="체험단 1회 등록"
                                android:textColor="#888888"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="15dp"
                            android:text="3,000원"
                            android:textColor="@color/text_100"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/radioTicket1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:buttonTint="@color/radio_tint" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5회 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTicket5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@null"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_100"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5회 등록권"
                                android:textColor="@color/text_100"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="체험단 5회 등록 (10% 할인)"
                                android:textColor="#888888"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvTicket5OriginalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="15,000원"
                                android:textColor="@color/error_red"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="13,500원"
                                android:textColor="@color/text_100"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <RadioButton
                            android:id="@+id/radioTicket5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:buttonTint="@color/radio_tint" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 10회 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTicket10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@null"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/border_100"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10회 등록권"
                                android:textColor="@color/text_100"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="체험단 10회 등록 (13% 할인)"
                                android:textColor="#888888"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvTicket10OriginalPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30,000원"
                                android:textColor="@color/error_red"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="26,000원"
                                android:textColor="@color/text_100"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <RadioButton
                            android:id="@+id/radioTicket10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:buttonTint="@color/radio_tint" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ── 토스페이먼츠 결제위젯 영역 (초기 GONE, 상품 선택 후 노출) ── -->
            <LinearLayout
                android:id="@+id/layoutPaymentSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="결제 수단"
                    android:textColor="@color/text_100"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.tosspayments.paymentsdk.view.PaymentMethod
                    android:id="@+id/paymentMethodWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <com.tosspayments.paymentsdk.view.Agreement
                    android:id="@+id/agreementWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── 하단 고정 버튼 영역 ─────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutBottomAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 1단계: 상품 선택 후 결제 정보 불러오기 -->
        <Button
            android:id="@+id/btnNext"
            style="@style/Widget.Honbab.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="다음" />

        <!-- 2단계: 결제 승인 재시도 (confirm 실패 시에만 노출) -->
        <Button
            android:id="@+id/btnRetryConfirm"
            style="@style/Widget.Honbab.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="결제 승인 다시 시도"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>