<?xml version="1.0" encoding="utf-8"?>
<!--
    채팅방 참가자 한 줄
    - 원형 프로필 (40dp)
    - 닉네임
    - 방장 뱃지 (방장일 때만 보임)
    - row 클릭 → ChatRoomParticipantDetailActivity
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- 원형 프로필 -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_participant_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_profile"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Honbab.Profile.Circle"
        android:layout_marginEnd="12dp" />

    <!-- 닉네임 -->
    <TextView
        android:id="@+id/tv_participant_nickname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="닉네임"
        android:textColor="@color/text_100"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 방장 뱃지 (호스트일 때만 visible) -->
    <!-- bg_host_badge : 주황 채움 + 둥근 모서리 (drawable/bg_host_badge.xml) -->
    <TextView
        android:id="@+id/tv_host_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="방장"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/host_badge_background"
        android:visibility="gone" />

    <!-- 3-dot 메뉴 버튼-->
    <ImageButton
        android:id="@+id/btn_participant_menu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_bar3_vertical"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="centerInside"
        android:contentDescription="멤버 관리"
        android:visibility="gone" />

</LinearLayout>