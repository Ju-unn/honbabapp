<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_200">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/bg_100"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerCrop"
            android:background="@color/white"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="체험단 상세"
            android:textColor="@color/primary_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.05"
            android:maxLines="1"
            android:ellipsize="end" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/btn_more_options"
                android:layout_width="35dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_3bar"
                android:scaleType="centerCrop"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- 스크롤 -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/apply_button_container">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 대표 이미지 -->
            <FrameLayout
                android:id="@+id/image_container"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:background="@color/bg_300"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iv_campaign_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_meeting_image" />

            </FrameLayout>

            <!-- 체험단 배지 -->
            <TextView
                android:id="@+id/tv_campaign_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="체험단"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/button_primary_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/image_container"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 체험단 제목 -->
            <TextView
                android:id="@+id/tv_campaign_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_100"
                android:textSize="22sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_campaign_badge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 가게 카테고리 -->
            <TextView
                android:id="@+id/tv_store_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_campaign_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 가게 주소 -->
            <TextView
                android:id="@+id/tv_store_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_store_category"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 가격대 -->
            <TextView
                android:id="@+id/tv_price_range"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_store_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 구분선 1 -->
            <View
                android:id="@+id/divider_1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_price_range"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ======================== 체험단 정보 섹션 ======================== -->

            <!-- 섹션 타이틀 -->
            <LinearLayout
                android:id="@+id/layout_campaign_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/divider_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/primary_100"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="체험단 정보"
                    android:textColor="@color/primary_200"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 홍보 채널 -->
            <LinearLayout
                android:id="@+id/layout_row_channels"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/layout_campaign_section_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_campaign"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="홍보 채널"
                    android:textColor="@color/text_200"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_campaign_channels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_100"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 제공 내역 -->
            <LinearLayout
                android:id="@+id/layout_row_provided"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/layout_row_channels"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_food"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="제공 내역"
                    android:textColor="@color/text_200"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_campaign_provided"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/primary_100"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 신청 조건 (데이터 없으면 GONE) -->
            <LinearLayout
                android:id="@+id/layout_row_requirements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/layout_row_provided"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_person"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="신청 조건"
                    android:textColor="@color/text_200"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_campaign_requirements"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_100"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- 모집 마감일 (데이터 없으면 GONE) -->
            <LinearLayout
                android:id="@+id/layout_row_deadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/layout_row_requirements"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_calendar"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:text="모집 마감"
                    android:textColor="@color/text_200"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_campaign_deadline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/accent_100"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 구분선 2 -->
            <View
                android:id="@+id/divider_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/layout_row_deadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ======================== 방문 정보 섹션 ======================== -->

            <TextView
                android:id="@+id/tv_visit_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="방문 정보"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_2"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 가이드라인 33% / 66% -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_33"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.33" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_66"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.66" />

            <!-- 날짜 아이콘 -->
            <ImageView
                android:id="@+id/iv_visit_date"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginStart="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_visit_info_title"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- 날짜 텍스트 -->
            <TextView
                android:id="@+id/tv_visit_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_visit_date"
                app:layout_constraintBottom_toBottomOf="@id/iv_visit_date"
                app:layout_constraintStart_toEndOf="@id/iv_visit_date"
                app:layout_constraintEnd_toStartOf="@id/guideline_33" />

            <!-- 시간 아이콘 -->
            <ImageView
                android:id="@+id/iv_visit_time"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_clock"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_visit_date"
                app:layout_constraintStart_toStartOf="@id/guideline_33" />

            <!-- 시간 텍스트 -->
            <TextView
                android:id="@+id/tv_visit_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_visit_date"
                app:layout_constraintBottom_toBottomOf="@id/iv_visit_date"
                app:layout_constraintStart_toEndOf="@id/iv_visit_time"
                app:layout_constraintEnd_toStartOf="@id/guideline_66" />

            <!-- 참여자 아이콘 -->
            <ImageView
                android:id="@+id/iv_participant_count"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_user"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/iv_visit_date"
                app:layout_constraintStart_toStartOf="@id/guideline_66" />

            <!-- 참여자 텍스트 -->
            <TextView
                android:id="@+id/tv_participant_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toTopOf="@id/iv_visit_date"
                app:layout_constraintBottom_toBottomOf="@id/iv_visit_date"
                app:layout_constraintStart_toEndOf="@id/iv_participant_count"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 구분선 3 -->
            <View
                android:id="@+id/divider_3"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_participant_count"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ======================== 호스트 메시지 섹션 ======================== -->

            <TextView
                android:id="@+id/tv_host_message_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="호스트 메시지"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_3"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_host_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_200"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/tv_host_message_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- 구분선 4 -->
            <View
                android:id="@+id/divider_4"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tv_host_message"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ======================== 위치 섹션 ======================== -->

            <TextView
                android:id="@+id/tv_location_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_4"
                app:layout_constraintStart_toStartOf="parent" />

            <com.naver.maps.map.MapView
                android:id="@+id/mini_map"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tv_location_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- MapView는 자체 터치 제스처가 클릭을 먼저 소비해 OnClickListener가 거의 발동하지 않음 -->
            <!-- 지도 위 투명 오버레이로 클릭을 대신 받는다 -->
            <View
                android:id="@+id/mini_map_click_overlay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintTop_toTopOf="@id/mini_map"
                app:layout_constraintBottom_toBottomOf="@id/mini_map"
                app:layout_constraintStart_toStartOf="@id/mini_map"
                app:layout_constraintEnd_toEndOf="@id/mini_map" />

            <!-- 구분선 5 -->
            <View
                android:id="@+id/divider_5"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/border_100"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/mini_map"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ======================== 참여자 섹션 ======================== -->

            <TextView
                android:id="@+id/tv_participants_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="참여자 (0/0)"
                android:textColor="@color/primary_100"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/divider_5"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_participants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/tv_participants_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- 하단 신청 버튼 -->
    <LinearLayout
        android:id="@+id/apply_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_100"
        android:padding="18dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_apply_campaign"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="체험단 신청하기"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary_background"
            android:elevation="2dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>