<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 모임 이미지 (상단) -->
        <ImageView
            android:id="@+id/iv_meeting_image"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:background="@color/bg_300"
            android:src="@drawable/placeholder_meeting_image"/>

        <!-- 모임 정보 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- 모임 제목 -->
                <TextView
                    android:id="@+id/tv_meeting_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="오늘 저녁 삼겹살 드실 분!"
                    android:textColor="@color/text_100"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_campaign_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/button_primary_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="체험단"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- 위치 + 시간 정보 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <!-- 위치 -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_location"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_meeting_location"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="강남역 맛집 골목"
                    android:textColor="@color/text_200"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- 시간 -->
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_clock"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_meeting_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오후 7:00"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- 모임 설명 -->
            <TextView
                android:id="@+id/tv_meeting_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="회사 근처에서 맛있는 삼겹살 먹고 싶어요! 같이 드실 분들 환영합니다."
                android:textColor="@color/text_200"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- 하단: 참여자 + 게시 시간 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <!-- 참여자 아바타들-->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 참여자 아바타들-->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 첫 번째 참여자 -->
                        <ImageView
                            android:id="@+id/iv_avatar_1"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profile"
                            android:scaleType="centerCrop"
                            android:background="@drawable/participant_avatar_background_1"
                            android:padding="1dp"
                            android:visibility="visible" />

                        <!-- 두 번째 참여자 -->
                        <ImageView
                            android:id="@+id/iv_avatar_2"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profile"
                            android:scaleType="centerCrop"
                            android:background="@drawable/participant_avatar_background_1"
                            android:layout_marginStart="-8dp"
                            android:padding="1dp"
                            android:visibility="gone" />

                        <!-- 세 번째 참여자 -->
                        <ImageView
                            android:id="@+id/iv_avatar_3"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_profile"
                            android:scaleType="centerCrop"
                            android:background="@drawable/participant_avatar_background_1"
                            android:layout_marginStart="-8dp"
                            android:padding="1dp"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

                <!-- 추가 필요 인원 -->
                <TextView
                    android:id="@+id/tv_participants_needed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+2명 더 필요"
                    android:textColor="@color/primary_200"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

                <!-- 게시 시간 -->
                <TextView
                    android:id="@+id/tv_post_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30분 전"
                    android:textColor="@color/text_200"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>