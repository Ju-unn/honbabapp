<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical">

    <!-- ── 핸들바 ── -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bottom_sheet_handle" />

    <!-- ── 헤더 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="필터"
            android:textColor="@color/text_100"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- ── 구분선 ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_200" />

    <!-- ── 지역 선택 섹션 (스크롤 밖 — 항상 보임) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="지역"
            android:textColor="@color/text_100"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 시/도 컬럼 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="시/도"
                    android:textColor="@color/text_200"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_sido"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/chip_button_background"
                    android:paddingHorizontal="12dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

            <!-- 구/군 컬럼 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="구/군"
                    android:textColor="@color/text_200"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_sigungu"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/chip_button_background"
                    android:paddingHorizontal="12dp"
                    android:spinnerMode="dropdown" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ── 구분선 ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_200" />

    <!--
        스크롤 영역 — bottomsheet_map_filter.xml과 동일하게
        layout_height="0dp" + layout_weight="1" 로 남은 공간을 채움
        → 칩이 생겨도 적용하기 버튼이 아래로 밀리지 않음
    -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="8dp">

            <!-- ===== 섹션 1: 홍보 플랫폼 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="홍보 플랫폼"
                android:textColor="@color/text_100"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_channel_blog"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="블로그"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_channel_instagram"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="인스타"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginHorizontal="3dp" />

                <Button
                    android:id="@+id/btn_channel_youtube"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="유튜브"
                    android:textSize="13sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- ===== 섹션 2: 카테고리 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="카테고리"
                android:textColor="@color/text_100"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- 첫 번째 줄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_category_korean"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="한식"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_category_chinese"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="중식"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginHorizontal="3dp" />

                <Button
                    android:id="@+id/btn_category_japanese"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="일식"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginHorizontal="3dp" />

                <Button
                    android:id="@+id/btn_category_western"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="양식"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- 두 번째 줄 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/btn_category_omakase"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="오마카세"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_category_cafe"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="카페"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginHorizontal="3dp" />

                <Button
                    android:id="@+id/btn_category_pub"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="술집"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_100"
                    android:background="@drawable/chip_button_background"
                    app:backgroundTint="@null"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:layout_marginHorizontal="3dp" />

                <!-- 정렬용 빈 칸 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <!-- ===== 섹션 3: 가격대 ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="자부담 가격"
                android:textColor="@color/text_100"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_price_range_display"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0원 ~ 100,000원"
                android:textColor="@color/text_200"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/range_slider_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100000"
                android:stepSize="5000"
                app:values="@array/initial_price_range"
                app:labelBehavior="gone"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0원"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100,000원"
                    android:textColor="@color/text_200"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!--
        하단 고정 영역 — bottomsheet_map_filter.xml과 동일한 구조
        NestedScrollView 밖에 위치해 칩이 아무리 많아져도 버튼이 밀리지 않음
    -->

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_200" />

    <!--
        선택된 필터 칩 영역
        - 초기엔 gone, 칩 1개 이상이면 visible
        - 왼쪽에 휴지통(전체 초기화) 버튼
    -->
    <LinearLayout
        android:id="@+id/layout_chip_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_trash"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_circle_gray"
            android:contentDescription="초기화"
            android:padding="8dp"
            android:src="@drawable/ic_delete" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:chipSpacingHorizontal="4dp" />

    </LinearLayout>

    <!-- 적용하기 버튼 — 하단 완전 고정 (bottomsheet_map_filter.xml과 동일) -->
    <Button
        android:id="@+id/btn_apply_filter"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        app:backgroundTint="@color/primary_100"
        android:text="적용하기"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="-0.01"
        app:cornerRadius="14dp" />

</LinearLayout>