<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 가 외부 앱(카메라 등)에 노출할 수 있는 경로 화이트리스트.
    여기에 명시되지 않은 경로는 FileProvider.getUriForFile() 호출 시
    IllegalArgumentException 이 발생함 (보안 안전장치).

    <cache-path>
        - getCacheDir() 기준 (앱 내부 캐시: /data/data/com.example.honbabapp/cache/)
        - 임시 파일에 적합. OS 가 용량 부족 시 자동 삭제.
        - 영구 보존이 필요한 파일은 <files-path> 사용 권장.

    path="chat_images/"
        - cache/chat_images/ 하위에 저장된 파일만 노출 허용
        - 카메라 촬영 시 cache/chat_images/cam_<ts>.jpg 로 임시 저장 → S3 업로드 → 정리

    name="chat_images"
        - URI 경로에 표시될 별칭 (content://<authority>/chat_images/...)
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="chat_images"
        path="chat_images/" />
</paths>