<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" /> <!-- 이미지 선택 권한 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 카메라 권한: 채팅 이미지 첨부 시 카메라로 직접 촬영용 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- FCM 푸시 알림 표시 권한-->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 카메라 하드웨어 요구 사항: required=false 로 카메라 없는 기기도 설치 허용 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".HonbabApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Honbabapp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!--
            FileProvider: 카메라로 촬영한 사진을 임시 파일로 저장하고
            카메라 앱한테 "여기에 저장해줘" 라고 content:// URI 로 안전하게 전달하기 위함.

            android:authorities = "${applicationId}.fileprovider"
              → 빌드 시 BuildConfig.APPLICATION_ID + ".fileprovider" 로 치환됨
              → 코드에서 FileProvider.getUriForFile() 호출 시 같은 문자열 사용해야 함

            android:exported = "false" → 다른 앱이 직접 접근 못 함 (Intent 의 grantUriPermissions 로만)
            android:grantUriPermissions = "true" → Intent.FLAG_GRANT_WRITE_URI_PERMISSION 사용 가능
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          FCM(Firebase Cloud Messaging) 푸시 알림 수신 서비스
        -->

        <service
            android:name=".fcm.FirebaseInstanceIdService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- FCM 기본 알림 아이콘/채널-->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/app_logo2" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />

        <meta-data
            android:name="com.naver.maps.map.NCP_KEY_ID"
            android:value="${NAVER_MAPS_CLIENT_ID}" />


        <!-- 카카오 로그인 인증 처리용 Activity -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activity.campaign.CampaignWritingActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.campaign.CampaignDetailActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".activity.payment.TicketPurchaseActivity"
            android:exported="false" />


        <activity
            android:name=".activity.campaign.CampaignApplyActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.campaign.CampaignApplicantListActivity"
            android:exported="false" />

        <activity
            android:name=".activity.campaign.CampaignEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".activity.chat.QrScannerActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name=".activity.profile.ProfileLogoutActivity"
            android:exported="false" />


        <activity
            android:name=".activity.chat.ChatRoomActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activity.meeting.MeetingEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <activity
            android:name=".activity.meeting.PlaceSearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.meeting.PlaceSearchImageSelectActivity"
            android:exported="false" />
        <activity
            android:name=".activity.NotificationActivity"
            android:exported="false" />
        <activity
            android:name=".activity.profile.ProfileChangePasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.profile.ProfileDeleteAccountActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.profile.ProfileNotificationSettingActivity"
            android:exported="false" />
        <activity
            android:name=".activity.profile.ProfileProfileSettingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.profile.ProfileAccountSettingActivity"
            android:exported="false" />
        <activity
            android:name=".activity.profile.ProfileMyMeetingsActivity"
            android:exported="false" />
        <activity
            android:name=".activity.profile.ProfileTicketActivity"
            android:exported="false" />
        <activity
            android:name=".activity.SearchViewActivity"
            android:exported="false" />
        <activity
            android:name=".activity.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.FindEmailActivity"
            android:exported="false" />
        <activity
            android:name=".activity.ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".activity.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".activity.meeting.MeetingDetailActivity"
            android:exported="false" />
        <activity
            android:name=".activity.meeting.MeetingApplicantListActivity"
            android:exported="false" />
        <activity
            android:name=".activity.meeting.MeetingCardWritingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".activity.chat.ChatRoomDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activity.chat.ChatRoomPhotosActivity"
            android:exported="false" />

        <activity
            android:name=".activity.chat.ChatRoomParticipantDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activity.chat.FullScreenImageActivity"
            android:exported="false" />


        <activity
            android:name=".activity.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activity.MainActivity"
            android:exported="true" />
    </application>

</manifest>